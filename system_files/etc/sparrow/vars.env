# Sparrow System Variables
# Examples are located here: https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/
# This is the prefered way to manage env vars for the default shell. (EnableUserCustomization = false)
QT_QPA_PLATFORMTHEME=qt6ct
QT_QPA_PLATFORM=wayland;xcb
GDK_BACKEND=wayland,x11,*
SDL_VIDEODRIVER=wayland
XDG_CURRENT_DESKTOP=Hyprland
XDG_SESSION_TYPE=wayland
XDG_SESSION_DESKTOP=Hyprland
XCURSOR_SIZE=24
